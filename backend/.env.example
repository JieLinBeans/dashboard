# Copy this file to .env and adjust as needed

# Postgres connection (either use DATABASE_URL or the discrete vars below)
DATABASE_URL=postgres://lms_user:lms_password@localhost:5432/lms_db

PGHOST=localhost
PGPORT=5432
PGUSER=lms_user
PGPASSWORD=lms_password
PGDATABASE=lms_db

PORT=3000
HOST=0.0.0.0

# Comma separated list of allowed CORS origins for the Angular dev server
CORS_ORIGIN=http://localhost:4200

# Optional: if set, the /api/chat endpoint will call the Anthropic API
# instead of using the built-in rule-based responder.
# ANTHROPIC_API_KEY=sk-ant-...
